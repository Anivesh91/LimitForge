{
  "name": "limitforge",
  "version": "8.0.0",
  "description": "Production-ready distributed rate limiting and resilience middleware for Express.js supporting Redis Lua, Token Bucket, Sliding Window, Circuit Breakers, and Prometheus metrics",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --watch examples/express-demo/server.js",
    "start": "node examples/express-demo/server.js",
    "demo:multi": "node examples/express-demo/multi-instance.js",
    "demo:sliding": "node examples/express-demo/sliding-demo.js",
    "demo:saas": "node examples/express-demo/saas-demo.js",
    "demo:burst": "node examples/express-demo/burst-demo.js",
    "demo:resilience": "node examples/express-demo/resilience-demo.js",
    "demo:observability": "node examples/express-demo/observability-demo.js",
    "demo:stack": "node examples/observability-stack/server.js",
    "demo:simulate": "node examples/observability-stack/simulate-traffic.js",
    "benchmark": "node scripts/benchmark.js",
    "test": "node --test"
  },
  "keywords": [
    "rate-limiter",
    "express",
    "middleware",
    "fixed-window",
    "sliding-window",
    "rolling-window",
    "token-bucket",
    "multi-tenant",
    "dynamic-policy",
    "circuit-breaker",
    "resilience",
    "prometheus",
    "opentelemetry",
    "in-memory",
    "redis",
    "distributed",
    "lua",
    "zset",
    "limitforge"
  ],
  "author": "Anivesh Sikarwar <aniveshsikarwar@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anivesh91/RateShield.git"
  },
  "bugs": {
    "url": "https://github.com/Anivesh91/RateShield/issues"
  },
  "homepage": "https://github.com/Anivesh91/RateShield#readme",
  "peerDependencies": {
    "express": "^4.21.2 || ^5.0.0",
    "redis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "redis": "^6.2.1",
    "supertest": "^7.0.0"
  }
}
